{
  "name": "billetera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/shared",
    "api",
    "web",
    "mobile"
  ],
  "scripts": {
    "build:shared": "npm run build -w packages/shared",
    "prebuild": "npm run build:shared",
    "build": "npm run build --workspaces --if-present",
    "predev": "npm run build:shared",
    "dev": "concurrently --names api,web --prefix-colors blue,green \"npm run dev -w api\" \"npm run dev -w web\"",
    "lint": "eslint .",
    "lint:verificar-reglas": "node scripts/verificar-reglas-lint.mjs",
    "lint:contrato": "redocly lint specs/openapi.yaml",
    "gen:tipos": "openapi-typescript specs/openapi.yaml -o packages/shared/src/api/openapi.ts --root-types --root-types-no-schema-prefix",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:shared",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm run db:migrate -w api",
    "db:migrate:revertir": "npm run db:migrate:revertir -w api",
    "db:seed": "npm run db:seed -w api",
    "db:explicar": "npm run db:explicar -w api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.72.1",
    "concurrently": "10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.6"
  }
}
