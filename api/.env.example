# Base de datos local (docker-compose.yml, design.md §1.3 y §3.4).
# La API corre con billetera_app; migraciones y seed con billetera_owner.
# El puerto es POSTGRES_PORT de docker-compose.yml (5433 por defecto).
DATABASE_URL=postgresql://billetera_app:billetera_app_dev@localhost:5433/billetera
DATABASE_URL_MIGRACIONES=postgresql://billetera_owner:billetera_owner_dev@localhost:5433/billetera
