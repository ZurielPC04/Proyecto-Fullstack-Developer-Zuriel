# Configuración de la API (design.md §2.4). Copia este archivo a api/.env.
# `npm run dev -w api` lo carga con --env-file-if-exists de Node 24; no se usa dotenv.
# Sin valor por defecto en el código: NODE_ENV, DATABASE_URL, JWT_SECRETO, OTP_HMAC_SECRETO,
# LIMITE_DIARIO_CENTAVOS, UMBRAL_CODIGO_CENTAVOS, FONDEO_BIENVENIDA_CENTAVOS, OTP_SIMULADO y WEB_ORIGIN.

NODE_ENV=development
PORT=3000

# Base de datos local (docker-compose.yml, design.md §1.3 y §3.4).
# La API corre con billetera_app. El puerto es POSTGRES_PORT de docker-compose.yml (5433 por defecto).
DATABASE_URL=postgresql://billetera_app:billetera_app_dev@localhost:5433/billetera
DB_POOL_MAX=10

# Secretos: 32 bytes o más y distintos entre sí. Vacíos a propósito: sin generarlos, la API no arranca.
# Genera cada uno con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRETO=
OTP_HMAC_SECRETO=

# Montos en centavos enteros (D-18). El umbral debe ser menor que el límite (D-13).
LIMITE_DIARIO_CENTAVOS=5000000
UMBRAL_CODIGO_CENTAVOS=1000000
# Fondeo de bienvenida de $10,000.00 (D-20). En producción debe ser 0.
FONDEO_BIENVENIDA_CENTAVOS=1000000

# OTP simulado (D-07): solo 'true' o 'false'. En producción debe ser false.
OTP_SIMULADO=true
# Latencia artificial en ms (D-17), 0 a 30000. En producción debe ser 0.
DEMO_LATENCIA_MS=0

# Solo el origen, sin "/" final; https: en producción (DD-24).
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=0

# No forma parte de la configuración de la API: solo la leen migrar.ts y seed.ts (T-API-04),
# con el rol dueño billetera_owner.
DATABASE_URL_MIGRACIONES=postgresql://billetera_owner:billetera_owner_dev@localhost:5433/billetera
