{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Decoradores de TypeORM (legacy). Sin emitDecoratorMetadata: esbuild (tsx, Vitest) no lo
    // soporta, así que cada @Column declara su type de forma explícita.
    "experimentalDecorators": true
  },
  "include": ["src"],
  "references": [{ "path": "../packages/shared" }]
}
