# URL de la API vista desde el teléfono (design.md §1.3, RNF-32).
# Con Expo Go en un teléfono físico usa la IP de esta computadora en la red local,
# por ejemplo http://192.168.1.50:3000/api. Nunca localhost ni 127.0.0.1: en el
# teléfono apuntan al propio teléfono.
EXPO_PUBLIC_API_URL=http://<IP-de-la-LAN>:3000/api

# FLAG_SECURE en Android (DD-44). false en desarrollo para poder grabar el video.
EXPO_PUBLIC_BLOQUEAR_CAPTURAS=false
